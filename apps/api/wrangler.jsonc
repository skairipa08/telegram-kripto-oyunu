{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "project-empire-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "workers_dev": false,
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
}
